# Usage 接続（Claude Code）の宣言＝KEY=VALUE（設計 §5.3）。
# usage/executor/usage-fetch.sh が短名（service）で引数 claude／codex／all
# を照合し、キャッシュ名 <短名>-cache.json を組み立てる。
# usage/executor/usage_snapshot.py が枠 id（pool_ref）・表示名（label）・
# チケット句の固定値（reset_credits_fixed_*＝現行 CLAUDE_RESET_CREDITS_FIXED
# の 4 項目）を読む。
service=claude
pool_ref=claude-subscription
label=Claude枠
reset_credits_fixed_available_count=
reset_credits_fixed_reset_scope=five_hour
reset_credits_fixed_credits=
reset_credits_fixed_note=not_machine_readable
