<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.takumi009.drift-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>__AIENV_HOME__/work/takumi009-ai-env/scripts/drift-notify.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__AIENV_HOME__</string>
        <!-- 他のplistより広いPATH: drift-notify.sh経由でcheck-drift.shが呼ぶ
             `gh`（GitHub CLI）はHomebrewで導入される想定（Brewfile）で、
             /usr/bin配下には無いため /opt/homebrew/bin・/usr/local/bin を含める。 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__AIENV_HOME__/Library/Logs/drift-check.log</string>
    <key>StandardErrorPath</key>
    <string>__AIENV_HOME__/Library/Logs/drift-check.log</string>
</dict>
</plist>
