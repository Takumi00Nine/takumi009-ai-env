#!/usr/bin/env bash
if [ "$1" != "app-server" ]; then
  exit 1
fi
if [ "${STUB_CODEX_TIMEOUT:-0}" = "1" ]; then
  while true; do sleep 1; done
fi
while IFS= read -r line; do
  id="$(printf '%s' "$line" | jq -r '.id // empty' 2>/dev/null)"
  if [ "$id" = "2" ]; then
    printf '%s\n' "${STUB_CODEX_RESULT_LINE:-}"
  fi
done
